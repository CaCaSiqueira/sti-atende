# Copie para .env.local e preencha. O .env.local nunca vai para o Git.
# Nenhuma destas variáveis usa o prefixo NEXT_PUBLIC_: todas ficam só no servidor.

# Supabase (Project Settings > API Keys). Use a chave SECRETA (sb_secret_... ou service_role).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Gemini (https://aistudio.google.com/apikey). Sem chave, o chat usa as regras locais.
GEMINI_API_KEY=
# Opcional: troca o modelo sem mexer no código.
GEMINI_MODEL=gemini-3.5-flash-lite
